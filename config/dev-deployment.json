{
  "track": "nixos",
  "serviceUrls": {
    "core": "http://127.0.0.1:3000",
    "mnet": "http://127.0.0.1:3104",
    "policy": "http://127.0.0.1:3101",
    "log": "http://127.0.0.1:3102",
    "eventbus": "http://127.0.0.1:3103",
    "task": "http://127.0.0.1:3105",
    "extension": "http://127.0.0.1:3106",
    "uiBff": "http://127.0.0.1:3200",
    "nodeAgent": "http://127.0.0.1:3307",
    "mDeploy": "http://127.0.0.1:3107"
  },
  "internalAuth": {
    "headerName": "Authorization",
    "tokenEnvVar": "MERISTEM_INTERNAL_TOKEN"
  },
  "oidc": {
    "provider": "local-dev"
  },
  "secretProvider": {
    "providerName": "dev-env",
    "backend": "local-dev-env",
    "namedProvider": {
      "name": "dev-env",
      "config": {
        "backend": "local-dev-env",
        "envMappings": {}
      }
    }
  },
  "secretBindings": [],
  "netbird": {
    "signalEndpoint": "http://127.0.0.1:3301",
    "relayEndpoint": "http://127.0.0.1:3302",
    "stunEndpoint": "stun:127.0.0.1:3478"
  },
  "nodeAgentCapabilities": {
    "netAdmin": false,
    "wireguardModulePath": "/lib/modules/extra/wireguard.ko",
    "wgBinaryPath": "/run/current-system/sw/bin/wg",
    "ipBinaryPath": "/run/current-system/sw/bin/ip"
  },
  "readiness": {
    "postgres": { "kind": "postgres-select-1", "target": "localhost" },
    "core": { "kind": "http-get", "target": "core", "endpoint": "http://127.0.0.1:3000/ready" },
    "mnet": { "kind": "http-get", "target": "mnet", "endpoint": "http://127.0.0.1:3104/ready" },
    "policy": { "kind": "http-get", "target": "policy", "endpoint": "http://127.0.0.1:3101/ready" },
    "log": { "kind": "http-get", "target": "log", "endpoint": "http://127.0.0.1:3102/ready" },
    "eventbus": { "kind": "http-get", "target": "eventbus", "endpoint": "http://127.0.0.1:3103/ready" },
    "task": { "kind": "http-get", "target": "task", "endpoint": "http://127.0.0.1:3105/ready" },
    "extension": { "kind": "http-get", "target": "extension", "endpoint": "http://127.0.0.1:3106/ready" },
    "uiBff": { "kind": "http-get", "target": "uiBff", "endpoint": "http://127.0.0.1:3200/ready" },
    "nodeAgent": { "kind": "http-get", "target": "nodeAgent", "endpoint": "http://127.0.0.1:3307/ready" },
    "mDeploy": { "kind": "http-get", "target": "mDeploy", "endpoint": "http://127.0.0.1:3107/ready" }
  }
}
