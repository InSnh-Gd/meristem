# Meristem 生产 compose 环境模板。
# 复制为 meristem.prod.env 后填写；敏感值建议由 secret 管理系统注入，不要提交真实值。

# ── 基础设施 ────────────────────────────────────────────────
POSTGRES_PASSWORD=change-me-strong-password
OPENSEARCH_INITIAL_PASSWORD=change-me-opensearch

# ── Meristem 共享密钥（bootstrap 自动铸造初始 token 也用它） ──
MERISTEM_INTERNAL_TOKEN=change-me-internal-token
MERISTEM_JWT_SECRET=change-me-jwt-secret

# ── 发布端口与外部地址 ──────────────────────────────────────
MERISTEM_CORE_PORT=3000
MERISTEM_BFF_PORT=3200
MERISTEM_UI_PORT=8080
MERISTEM_JOIN_INGRESS_PORT=8443
# 浏览器可达的 BFF 地址（构建期烧入 M-UI 静态产物）
MERISTEM_PUBLIC_BFF_URL=http://localhost:3200
# 节点可达的 Join Ingress 地址（生产应指向真实域名 + 有效证书）
MERISTEM_JOIN_PUBLIC_URL=https://localhost:8443
# 留空使用 compose 默认 https://m-net:8443（容器 DNS）；
# 若指向外部地址需提供有效证书，不要填 localhost（容器内指向自身）
# MERISTEM_JOIN_URL=

# ── 镜像仓库（远程部署时必填） ──────────────────────────────
# MERISTEM_REGISTRY=registry.example.com/meristem
MERISTEM_TAG=latest
BUN_VERSION=1

# ── Bootstrap 初始 actor 列表 ───────────────────────────────
MERISTEM_BOOTSTRAP_ACTORS=admin

# ── OIDC（可选，生产身份认证启用时填写） ────────────────────
# MERISTEM_OIDC_ISSUER=
# MERISTEM_OIDC_DISCOVERY_URL=
# MERISTEM_OIDC_AUDIENCES=
# MERISTEM_OIDC_ALLOWED_ALGORITHMS=

# ── NetBird 数据面（阶段 2 数据面启用时填写） ────────────────
# MERISTEM_NETBIRD_SIGNAL_ENDPOINT=
# MERISTEM_NETBIRD_RELAY_ENDPOINT=
# MERISTEM_NETBIRD_STUN_ENDPOINT=
