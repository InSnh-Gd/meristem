MERISTEM_OPENSEARCH_IMAGE=registry.example.invalid/meristem/opensearch:2.19.1-prometheus
MERISTEM_OPENSEARCH_TLS_DIR=/var/lib/meristem/secrets/opensearch-tls
MERISTEM_PINO_LOG_DIR=/var/lib/meristem/logs
OPENSEARCH_ADMIN_USERNAME=admin
OPENSEARCH_ADMIN_PASSWORD=replace-with-secretref-materialized-value
OPENSEARCH_DASHBOARDS_USERNAME=dashboards-readonly
OPENSEARCH_DASHBOARDS_PASSWORD=replace-with-secretref-materialized-value
OPENSEARCH_MONITORING_USERNAME=monitoring
OPENSEARCH_MONITORING_PASSWORD=replace-with-secretref-materialized-value
OPENSEARCH_SNAPSHOT_BUCKET=meristem-opensearch-snapshots
OPENSEARCH_SNAPSHOT_REGION=us-east-1
OPENSEARCH_SNAPSHOT_BASE_PATH=meristem/opensearch
DASHBOARDS_OIDC_CLIENT_ID=meristem-dashboards
DASHBOARDS_OIDC_CLIENT_SECRET=replace-with-secretref-materialized-value
DASHBOARDS_OIDC_COOKIE_SECRET=replace-with-secretref-materialized-value
DASHBOARDS_OIDC_ISSUER_URL=https://issuer.example.invalid/realms/meristem
GRAFANA_ADMIN_PASSWORD=replace-with-secretref-materialized-value
MERISTEM_ALERT_WEBHOOK_URL=https://operations.example.invalid/alerts
